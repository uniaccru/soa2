<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="DragonPU" transaction-type="JTA">
        <jta-data-source>java:/jdbc/DragonDS</jta-data-source>
        <class>org.example.dragon.entity.Dragon</class>
        <class>org.example.dragon.entity.Cave</class>
        <class>org.example.dragon.entity.Team</class>
        <class>org.example.dragon.entity.Coordinates</class>
        <class>org.example.dragon.entity.Person</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!-- схемой управляет Liquibase (db/changelog) -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
